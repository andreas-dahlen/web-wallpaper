{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,

    "lib": [ "ES2022" ],
    "types": [ "node", "vscode" ],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "rootDir": "src",
    "outDir": "dist",

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [ "src/**/*.ts" ]
}